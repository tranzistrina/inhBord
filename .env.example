# Server
HOST=0.0.0.0
PORT=4568

# Use a long random secret in production.
INHBORD_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=0

# Optional: choose a persistent path for board files.
# INHBORD_DATA_DIR=/var/lib/inhbord/boards
# Default storage quota: 1 GiB (1073741824 bytes)
INHBORD_MAX_STORAGE_BYTES=1073741824
INHBORD_MAX_TEXT_CHARS=2000000
# In production, restrict this to the origins that host the board.
# INHBORD_CORS=https://your-domain.example
